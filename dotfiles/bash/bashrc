# dev-env shell additions. Sourced from ~/.bashrc by bootstrap.sh.

case $- in
  *i*) ;;
  *) return ;;
esac

# TinyTeX from bootstrap; its bin dir must be on PATH itself (tlmgr breaks through symlinks).
for _tex_bin in "$HOME"/.local/opt/dev-env/tinytex/bin/*; do
  [[ -d "$_tex_bin" ]] && export PATH="$_tex_bin:$PATH"
done
unset _tex_bin
export PATH="$HOME/.local/bin:$PATH"
export EDITOR=nvim
export VISUAL=nvim
export PAGER=less
export LESS='-R'

alias ll='ls -alF'
alias la='ls -A'
alias gs='git status -sb'
alias gd='git diff'
alias gl='git log --oneline --decorate --graph -20'
alias v='nvim'
alias vim='nvim'
alias lg='lazygit'
alias ya='yazi'

# Yazi wrapper: when Yazi exits, follow its final directory in the current shell.
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

if [ -f "$HOME/dev-env/dotfiles/bash/functions.sh" ]; then
    source "$HOME/dev-env/dotfiles/bash/functions.sh"
fi
