ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ARG ENV_NAME
ARG PYTHON_VERSION=3.12
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
ARG NVIM_VERSION=v0.12.4
ARG LAZYGIT_VERSION=0.64.1
ARG UV_VERSION=0.12.5
ARG DEV_TOOLS_PYTHON=3.12

ENV DEBIAN_FRONTEND=noninteractive \
    EDITOR=nvim \
    VISUAL=nvim \
    TERM=xterm-256color \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/dev-tools/bin:/usr/local/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY install/ /tmp/dev-env/install/
RUN NVIM_VERSION="$NVIM_VERSION" \
    LAZYGIT_VERSION="$LAZYGIT_VERSION" \
    UV_VERSION="$UV_VERSION" \
    DEV_TOOLS_PYTHON="$DEV_TOOLS_PYTHON" \
    /tmp/dev-env/install/install-ide.sh

# Optional environment-specific OS dependencies. Blank lines and comments are ignored.
COPY environments/${ENV_NAME}/system-packages.txt /tmp/dev-env/system-packages.txt
RUN packages="$(grep -Ev '^[[:space:]]*(#|$)' /tmp/dev-env/system-packages.txt | tr '\n' ' ')" && \
    if [[ -n "$packages" ]]; then \
      apt-get update && apt-get install -y --no-install-recommends $packages && \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Named research Python environment, recreated entirely from the versioned lock file.
COPY environments/${ENV_NAME}/requirements.lock.txt /tmp/dev-env/requirements.lock.txt
RUN uv python install "$PYTHON_VERSION" && \
    uv venv --python "$PYTHON_VERSION" /opt/venv && \
    uv pip sync --allow-empty-requirements \
      --python /opt/venv/bin/python \
      /tmp/dev-env/requirements.lock.txt && \
    uv pip install --python /opt/venv/bin/python debugpy ruff && \
    /tmp/dev-env/install/create-user.sh "$USERNAME" "$USER_UID" "$USER_GID" && \
    chown -R "$USER_UID:$USER_GID" /opt/venv && \
    rm -rf /tmp/dev-env

COPY --chown=${USER_UID}:${USER_GID} dotfiles/nvim/ /home/${USERNAME}/.config/nvim/
COPY --chown=${USER_UID}:${USER_GID} dotfiles/yazi/ /home/${USERNAME}/.config/yazi/
COPY --chown=${USER_UID}:${USER_GID} dotfiles/tmux/tmux.conf /home/${USERNAME}/.tmux.conf
COPY --chown=${USER_UID}:${USER_GID} dotfiles/bash/bashrc /home/${USERNAME}/.bashrc

USER ${USERNAME}
WORKDIR /workspaces
CMD ["sleep", "infinity"]
