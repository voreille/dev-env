ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG USERNAME=dev
ARG USER_UID=1000
ARG USER_GID=1000
ARG NVIM_VERSION=v0.12.4
ARG LAZYGIT_VERSION=0.63.1

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    EDITOR=nvim \
    VISUAL=nvim \
    TERM=xterm-256color \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Core shell, build, Python and research/dev utilities.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    bash-completion \
    bat \
    build-essential \
    ca-certificates \
    curl \
    fd-find \
    file \
    fzf \
    git \
    htop \
    jq \
    less \
    openssh-client \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    ripgrep \
    rsync \
    sudo \
    tmux \
    tree \
    unzip \
    wget \
    xz-utils \
    zip \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu names these binaries differently from the common CLI names.
RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd && \
    if command -v batcat >/dev/null 2>&1; then ln -sf /usr/bin/batcat /usr/local/bin/bat; fi && \
    ln -sf /usr/bin/python3 /usr/local/bin/python

# Neovim: pin a known stable release instead of relying on Ubuntu's older package.
RUN arch="$(dpkg --print-architecture)" && \
    case "$arch" in \
      amd64) nvim_arch="x86_64" ;; \
      arm64) nvim_arch="arm64" ;; \
      *) echo "Unsupported architecture for Neovim binary: $arch" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-${nvim_arch}.tar.gz" -o /tmp/nvim.tar.gz && \
    tar -xzf /tmp/nvim.tar.gz -C /opt && \
    ln -sf "/opt/nvim-linux-${nvim_arch}/bin/nvim" /usr/local/bin/nvim && \
    rm /tmp/nvim.tar.gz

# Yazi's official apt repository provides current Ubuntu/Debian builds.
RUN curl -fsSL https://yazi-rs.github.io/builds/yazi-keyring.gpg \
      -o /usr/share/keyrings/yazi-keyring.gpg && \
    echo 'deb [signed-by=/usr/share/keyrings/yazi-keyring.gpg] https://yazi-rs.github.io/builds/ stable main' \
      > /etc/apt/sources.list.d/yazi.list && \
    apt-get update && apt-get install -y --no-install-recommends yazi && \
    rm -rf /var/lib/apt/lists/*

# Lazygit.
RUN arch="$(dpkg --print-architecture)" && \
    case "$arch" in \
      amd64) lg_arch="x86_64" ;; \
      arm64) lg_arch="arm64" ;; \
      *) echo "Unsupported architecture for lazygit binary: $arch" >&2; exit 1 ;; \
    esac && \
    curl -fsSL \
      "https://github.com/jesseduffield/lazygit/releases/download/v${LAZYGIT_VERSION}/lazygit_${LAZYGIT_VERSION}_Linux_${lg_arch}.tar.gz" \
      -o /tmp/lazygit.tar.gz && \
    tar -xzf /tmp/lazygit.tar.gz -C /tmp lazygit && \
    install /tmp/lazygit /usr/local/bin/lazygit && \
    rm -f /tmp/lazygit /tmp/lazygit.tar.gz

# Match the host UID/GID so bind-mounted workspace and NAS files are not created as root.
RUN if getent group "${USER_GID}" >/dev/null; then \
      existing_group="$(getent group "${USER_GID}" | cut -d: -f1)"; \
      groupmod -n "${USERNAME}" "${existing_group}" 2>/dev/null || true; \
    else \
      groupadd --gid "${USER_GID}" "${USERNAME}"; \
    fi && \
    if id -u "${USERNAME}" >/dev/null 2>&1; then \
      usermod --uid "${USER_UID}" --gid "${USER_GID}" "${USERNAME}"; \
    else \
      useradd --uid "${USER_UID}" --gid "${USER_GID}" -m -s /bin/bash "${USERNAME}"; \
    fi && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" && \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"

# A writable Python environment inherited by project images. This keeps Python
# tooling out of the system interpreter and lets project Dockerfiles simply RUN pip install ...
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/python -m pip install --upgrade pip && \
    /opt/venv/bin/pip install debugpy pyright ruff uv && \
    chown -R ${USER_UID}:${USER_GID} /opt/venv

RUN mkdir -p \
      /home/${USERNAME}/.config/nvim \
      /home/${USERNAME}/.config/yazi \
      /home/${USERNAME}/.config/tmux \
      /home/${USERNAME}/.ssh \
      /home/${USERNAME}/.local/share/nvim \
      /home/${USERNAME}/.local/state/nvim \
      /home/${USERNAME}/.cache/nvim \
      /home/${USERNAME}/.cache/huggingface \
      /home/${USERNAME}/.cache/torch \
      /home/${USERNAME}/.cache/uv \
      /workspaces && \
    chown -R ${USER_UID}:${USER_GID} /home/${USERNAME} /workspaces

COPY --chown=${USER_UID}:${USER_GID} dotfiles/nvim/ /home/${USERNAME}/.config/nvim/
COPY --chown=${USER_UID}:${USER_GID} dotfiles/yazi/ /home/${USERNAME}/.config/yazi/
COPY --chown=${USER_UID}:${USER_GID} dotfiles/tmux/tmux.conf /home/${USERNAME}/.tmux.conf
COPY --chown=${USER_UID}:${USER_GID} dotfiles/bash/bashrc /home/${USERNAME}/.bashrc

USER ${USERNAME}
WORKDIR /workspaces

CMD ["sleep", "infinity"]
