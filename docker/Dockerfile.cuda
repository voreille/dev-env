ARG BASE_IMAGE=dev-env-base:cuda12.3
FROM ${BASE_IMAGE}

ENV DEV_VARIANT=cuda \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

LABEL org.opencontainers.image.title="dev-env CUDA"
LABEL org.opencontainers.image.description="Terminal-first CUDA development environment"

CMD ["sleep", "infinity"]
